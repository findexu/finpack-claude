{
  "name": "quest-dashboard",
  "displayName": "Quest Dashboard",
  "description": "Live RPG dashboard for quest-system adventurers",
  "version": "0.1.0",
  "publisher": "finpack",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.claude/quest-xp/profile.md"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quest-dashboard",
          "title": "Quest Dashboard",
          "icon": "assets/sprites/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "quest-dashboard": [
        {
          "id": "questDashboard.characterSheet",
          "name": "Character",
          "type": "webview"
        },
        {
          "id": "questDashboard.questTree",
          "name": "Active Quest",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "questDashboard.refresh",
        "title": "Quest Dashboard: Refresh"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "questDashboard.refresh",
          "when": "view == questDashboard.questTree",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test \"out-tests/tests/**/*.test.js\""
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
